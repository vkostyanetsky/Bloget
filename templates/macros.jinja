{#
  A tag chip is clickable, unless the blog's metadata knows nothing about the
  tag (there is neither a name to show, nor a page to open).

  In a note list a chip filters the list (tag_urls is not passed), on a note
  page it leads to a pre-generated list of the tag (tag_urls is a mapping of
  a tag to an URL of its list).
#}
{% macro note(note, tags, settings, language, show_title=false, tag_urls=none) %}

{% set tag_chip_class = "inline-flex items-center rounded-full border border-slate-200 bg-slate-50 px-2.5 py-1 text-xs text-slate-700" %}
{% set tag_chip_class_clickable = tag_chip_class ~ " cursor-pointer transition hover:bg-slate-100" %}

        <article class="rounded-2xl bg-white">

          <header class="space-y-2">

            {% if show_title %}            
            <header class="space-y-2">
            <a href="{{ settings['url'] }}/{{ note.path }}"
                class="inline text-2xl font-semibold tracking-tight hover:underline">
                {{ note.title }}
            </a>
            </header>
            {% endif %}

            <div class="flex flex-wrap items-center gap-x-3 gap-y-2 text-sm text-slate-600">
              <span>{{ note.created.strftime('%d').lstrip('0') }} {{ language.get('months').get(note.created.strftime('%m')) }} {{ note.created.strftime('%Y') }}</span>
              {% if note.tags %}
                <span class="text-slate-300">·</span>
                {% for tag in note.tags %}
                <div class="flex flex-wrap gap-2">
                    {% if tag not in tags %}
                    <span class="{{ tag_chip_class }}">{{ tags[tag] }}</span>
                    {% elif tag_urls %}
                    <a href="{{ tag_urls[tag] }}" class="{{ tag_chip_class_clickable }}">{{ tags[tag] }}</a>
                    {% else %}
                    <button type="button" data-chip="{{ tag }}" class="{{ tag_chip_class_clickable }}">{{ tags[tag] }}</button>
                    {% endif %}
                </div>
                {% endfor %}
              {% endif %}
            </div>

          </header>

          <div class="mt-5">
            <div class="prose-like">
              {{ note.text | safe }}
            </div>
          </div>
          
        </article>

{% endmacro %}

{% macro page_header(title, description) %}

      <header class="space-y-3">
        <h1 class="text-3xl font-semibold tracking-tight">{{ title }}</h1>
        <p class="max-w-2xl text-slate-700">
          {{ description }}
        </p>
      </header>

{% endmacro %}

{% macro search_indicator() %}
  <svg
    class="search-indicator pointer-events-none absolute right-3 top-1/2 h-5 w-5 -translate-y-1/2 text-slate-400"
    xmlns="http://www.w3.org/2000/svg"
    fill="none"
    viewBox="0 0 24 24"
    stroke="currentColor"
    stroke-width="2"
    aria-hidden="true"
  >
    <path class="search-symbol" stroke-linecap="round" stroke-linejoin="round"
      d="m21 21-4.35-4.35m1.35-5.65a7 7 0 1 1-14 0 7 7 0 0 1 14 0Z" />
    <circle class="search-spinner" cx="12" cy="12" r="8"
      stroke-linecap="round" stroke-dasharray="38 13" />
  </svg>
{% endmacro %}
